# --- iMessage Configuration ---
# Find this path: usually ~/Library/Messages/chat.db
# Use the full path, e.g., /Users/yourusername/Library/Messages/chat.db
DB_PATH="/Users/yourusername/Library/Messages/chat.db"

# The phone numbers OR chat identifiers (for group chats) you want the bot to interact with, seperated by commas.
# Use the format Messages uses, e.g., "+11234567890,+12016551691" or "chatxxxxxxxxxxxxxxxxxx"
TARGET_CHAT_IDENTIFIERS=""

# --- LLM Configuration ---
# Your OpenAI API endpoint URL
OPENAI_API_ENDPOINT="https://api.openai.com/v1/chat/completions" # Or your custom endpoint

# Your API Key
OPENAI_API_KEY=""

# The model to use
LLM_MODEL="gpt-4o-mini"

# --- Bot Behavior ---
# System prompt to guide the chatbot's personality and task
SYSTEM_PROMPT="You are a helpful assistant continuing a conversation in iMessage. Keep your replies concise and suitable for a text message format. Do not include sender prefixes like 'Me:' or 'Them:' in your final response. Just provide the message content."

# How many past messages to include as context for the LLM
MESSAGE_CONTEXT_LIMIT=10

# How often to check for new messages (in milliseconds)
POLL_INTERVAL_MS=5000 # Check every 5 seconds

# Optional: A name for the bot user (used in context prompt)
BOT_NAME="Me"
# Optional: A name for the other user (used in context prompt)
OTHER_USER_NAME="Them"
